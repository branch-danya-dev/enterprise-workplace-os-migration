@startuml
title Workplace Migration Scheduling and Execution Process

start

:Workplace added to migration schedule;
:Assign migration date;
:Notify user about scheduled migration;

if (Postponement request received?) then (Yes)

    :Create Service Desk request;
    :Review postponement reason;

    if (Postponement approved?) then (Yes)
        :Mark workplace as postponed;
        :Assign new migration date;
        :Notify user about new date;
    else (No)
        :Keep original migration date;
    endif

else (No)
    :Keep scheduled migration date;
endif

:Wait for migration date;
:Start automated migration;

if (Automated migration successful?) then (Yes)

    :Mark workplace as migrated;

else (No)

    :Register technical migration issue;
    :Workplace Support takes over workstation;
    :Perform manual migration;
    :Remove Windows;
    :Install Astra Linux;
    :Restore required workplace environment;
    :Restore required workplace environment;
    :Mark workplace as migrated;

endif

stop
@enduml