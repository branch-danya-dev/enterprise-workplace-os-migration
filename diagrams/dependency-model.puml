@startuml
title Enterprise Workplace OS Migration - Dependency Model

left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center

actor User

rectangle "Workplace Environment" {

    rectangle "Workplace" as Workplace

    rectangle "Operating System" as OS {
        rectangle "Windows" as Windows
        rectangle "Astra Linux" as Astra
    }

    rectangle "Standard Software" as StandardSoftware {
        rectangle "Office Suite" as OfficeSuite
        rectangle "Yandex Browser" as YandexBrowser
        rectangle "Kaspersky Antivirus" as Kaspersky
    }

    rectangle "Specialized Software" as SpecializedSoftware {
        rectangle "R7 Spreadsheets" as R7
        rectangle "1C-based Software" as OneC
        rectangle "Development Tools / IDEs" as DevTools
        rectangle "Other Role-specific Software" as RoleSoftware
    }

    rectangle "Access Rights" as AccessRights
    rectangle "Hardware / Peripherals" as Hardware
}

rectangle "Corporate Services" as CorporateServices {
    rectangle "Active Directory" as AD
    rectangle "Corporate Email" as Email
    rectangle "Molniya Messenger" as Molniya
    rectangle "Newton Forum" as Newton
    rectangle "Network Drives" as NetworkDrives
    rectangle "Internal Web Applications" as WebApps
    rectangle "Automatic Update Systems" as Updates
    rectangle "Security Systems" as SecuritySystems
}

rectangle "Security and Access Control" as Security {
    rectangle "Information Security Approval" as ISApproval
    rectangle "Firewall / Network Access Rules" as Firewall
    rectangle "Certificates / CryptoPro Tokens" as Certificates
}

rectangle "Business Context" as BusinessContext {
    rectangle "Department / Business Role" as BusinessRole
    rectangle "Business Activity" as BusinessActivity
}

rectangle "Migration Control" as MigrationControl {
    rectangle "Compatibility Status" as CompatibilityStatus
    rectangle "Migration Readiness" as MigrationReadiness
    rectangle "Migration Schedule / Wave" as MigrationWave
    rectangle "Stop Factor / Exception" as StopFactor
    rectangle "Dual-Boot Transitional State" as DualBoot
}

rectangle "Support and Delivery Teams" as Teams {
    rectangle "Workplace Support" as WorkplaceSupport
    rectangle "Information Security" as ISTeam
    rectangle "Infrastructure Automation" as InfraAutomation
    rectangle "Software / Office Applications Support" as SoftwareSupport
    rectangle "Telephony Support" as TelephonySupport
    rectangle "Vendor / Developer" as Vendor
}

User --> Workplace : uses
User --> BusinessRole : belongs to / performs
BusinessRole --> BusinessActivity : defines
BusinessActivity --> StandardSoftware : requires
BusinessActivity --> SpecializedSoftware : may require
BusinessActivity --> CorporateServices : requires access to

Workplace --> OS : runs
Workplace --> Hardware : includes
Workplace --> StandardSoftware : contains
Workplace --> SpecializedSoftware : may contain

StandardSoftware --> OS : must be compatible with
SpecializedSoftware --> OS : must be compatible with
Hardware --> OS : requires compatible drivers

User --> AccessRights : has
AccessRights --> CorporateServices : grants access to
AccessRights --> SpecializedSoftware : may grant access to

AccessRights --> Firewall : enforced through
AccessRights --> ISApproval : may require approval
Certificates --> AccessRights : enables protected access
Certificates --> Workplace : may be required for login

AD --> User : authenticates
CorporateServices --> SecuritySystems : protected by
Updates --> Workplace : distributes updates to

CompatibilityStatus --> StandardSoftware : evaluates
CompatibilityStatus --> SpecializedSoftware : evaluates
CompatibilityStatus --> Hardware : evaluates

CompatibilityStatus --> MigrationReadiness : influences
AccessRights --> MigrationReadiness : influences
CorporateServices --> MigrationReadiness : influences
Security --> MigrationReadiness : influences
BusinessActivity --> MigrationReadiness : defines acceptable outcome

MigrationReadiness --> MigrationWave : determines inclusion in
StopFactor --> MigrationReadiness : blocks
StopFactor --> MigrationWave : may postpone
DualBoot --> MigrationReadiness : represents partial readiness

WorkplaceSupport --> MigrationReadiness : tracks
ISTeam --> ISApproval : validates
InfraAutomation --> Workplace : supports migration tooling
SoftwareSupport --> CompatibilityStatus : validates software
TelephonySupport --> MigrationReadiness : validates related dependencies
Vendor --> SpecializedSoftware : develops / adapts

SpecializedSoftware --> StopFactor : may create
Hardware --> StopFactor : may create
CorporateServices --> StopFactor : may create
AccessRights --> StopFactor : may create

Windows --> DualBoot : retained when required
Astra --> DualBoot : installed alongside
DualBoot --> Astra : transitions to full Astra state

@enduml